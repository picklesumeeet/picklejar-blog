# The real public-facing site URL, e.g. https://walletpickle.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side API URL (Used during Next.js build and SSR). MUST be absolute URL.
API_URL=https://your-backend.com/api

# Client-side API URL (Used by browser). Should be /api to use the Next.js proxy.
NEXT_PUBLIC_API_URL=/api

# Cloudinary configuration for image uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
